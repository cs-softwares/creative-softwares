# Contact form email delivery
# CONTACT_FROM_EMAIL should use a verified sender on Resend.
# For temporary testing, you can use: "Creative Softwares <onboarding@resend.dev>"
# If you use onboarding@resend.dev, CONTACT_TO_EMAIL should be the inbox tied to your Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Creative Softwares <inquiries@yourdomain.com>"

# Optional. If left empty, the site email in app/site-content.ts is used.
CONTACT_TO_EMAIL=creativesoftwares96@gmail.com
